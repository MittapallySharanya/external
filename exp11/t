```

## STEP 3: Create pom.xml

```powershell
@'
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>examples.demo</groupId>
    <artifactId>exp11-karate-demo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.intuit.karate</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
'@ | Set-Content -Path "pom.xml"
```

## STEP 4: Create cal.js

Location:

`src/test/resources/examples/demo/cal.js`

```powershell
@'
function(a, b) {
    return a + b;
}
'@ | Set-Content -Path "src\test\resources\examples\demo\cal.js"
```

## STEP 5: Create cal.feature

Location:

`src/test/resources/examples/demo/cal.feature`

```powershell
@'
Feature: JavaScript Calculator Testing

  Scenario: Addition of two numbers
    * def calculator = read('cal.js')
    * def result = calculator(10, 20)
    * match result == 30

  Scenario: Addition of another two numbers
    * def calculator = read('cal.js')
    * def result = calculator(5, 15)
    * match result == 20
'@ | Set-Content -Path "src\test\resources\examples\demo\cal.feature"
```

## STEP 6: Create KarateTest.java

Location:

`src/test/java/examples/demo/KarateTest.java`

```powershell
@'
package examples.demo;

import com.intuit.karate.junit5.Karate;

class KarateTest {

    @Karate.Test
    Karate testCalculator() {
        return Karate.run("classpath:examples/demo");
    }
}
'@ | Set-Content -Path "src\test\java\examples\demo\KarateTest.java"
```

## STEP 7: Check Project Structure

```powershell
tree /f
```

Expected structure:

```text
